		<region region-id="160" left="498" top="44.25" width="123" height="73.5" align-x="530.25" align-y="96" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
